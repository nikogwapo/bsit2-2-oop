import java.util.ArrayList;

public class Food_Menu {
    private String customerName;
    private ArrayList<String> items;
    private ArrayList<Double> prices;
    private String size;
    private static int totalOrders = 0;

    public Food_Menu(String customerName, String size) {
        this.customerName = customerName;
        this.size = size;
        this.items = new ArrayList<>();
        this.prices = new ArrayList<>();
        totalOrders++;
    }

    public void addItem(String item, double price) {
        if (item == null || item.isEmpty()) {
            throw new IllegalArgumentException("Error: Invalid item: cannot be empty");
        }
        if (price <= 0) {
            throw new IllegalArgumentException("Error: Invalid price: must be greater than 0");
        }
        items.add(item);
        prices.add(price);
    }

    public double getTotalPrice() {
        double total = 0.0;
        for (double price : prices) {
            total += price;
        }
        return total;
    }

    public String getCustomerName() {
        return customerName;
    }

    public static int getTotalOrders() {
        return totalOrders;
    }

    public static Food_Menu getHighestOrder(Food_Menu... orders) {
        Food_Menu highest = null;
        double highestTotal = 0;

        for (Food_Menu order : orders) {
            double total = order.getTotalPrice();
            if (total > highestTotal) {
                highestTotal = total;
                highest = order;
            }
        }
        return highest;
    }

    @Override
    public String toString() {
        StringBuilder orderDetails = new StringBuilder("Order for " + customerName + ": ");
        orderDetails.append(items.size()).append(" items, Total: $").append(String.format("%.2f", getTotalPrice()))
                .append(", Size: ").append(size);
        return orderDetails.toString();
    }
}
