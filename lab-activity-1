
import java.util.Scanner;

public class Main {



    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Enter Student ID: ");
        String id = scanner.nextLine();

        System.out.println("Enter First Name: ");
        String firstname = scanner.nextLine();

        System.out.println("Enter Last Name: ");
        String lastname = scanner.nextLine();

        System.out.println("Enter Course: ");
        String course = scanner.nextLine();

        System.out.println("Enter Section: ");
        String section = scanner.nextLine();


        System.out.println("\nSTUDENT INFORMATION");
        System.out.println("Student ID: " + id);
        System.out.println("Student Name: " + firstname + " " + lastname);
        System.out.println("Course: " + course);
        System.out.println("Section: " + section);


        int averagescore =75;

        System.out.println("Enter Midterm Exam: ");
        int midtermexam = scanner.nextInt();

        System.out.println("Enter Final Exam Score: ");
        int finalexam = scanner.nextInt();

        System.out.println("Enter Project Score: ");
        int projectscore = scanner.nextInt();

        System.out.println("Enter Attendance Percentage: ");
        int attendance = scanner.nextInt();


        int total = midtermexam + finalexam + projectscore + attendance;

        System.out.println("\nMidterm Exam Score: " + midtermexam);
        System.out.println("Final Exam Score: " + finalexam);
        System.out.println("Project Score: " + projectscore);
        System.out.println("Attedance Percentage: " + attendance);
        System.out.println("Average Score: " + total);


        if (averagescore <= 75) {
            System.out.println("Remarks: Failed");
        }else {
            System.out.println("Remarks: Pass");
            return;






        }



    }

}
