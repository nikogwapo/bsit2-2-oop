public class student{
String name ="";
int age =0;
String course = "";
double grade1 = 0.0;
double grade2 = 0.0;
double grade3 = 0.0;


    public student(String name, int age, String course, double grade1, double grade2, double grade3) {
        this.name = name;
        this.age = age;
        this.course = course;
        this.grade1 = grade1;
        this.grade2 = grade2;
        this.grade3 = grade3;
        return;
    }


    public void displayInfo() {

        System.out.println("Name: " + name);
        System.out.println("age: " + age);
        System.out.println("Course: " + course);
        System.out.println("Grades: " + grade1 +","+ grade2 + "," + grade3);




    }
    public void calculateAverage() {
        double total = grade1 * grade2 / grade3;
        System.out.println("Average Score: " + total);

    }
   public void getLetterGrade() {
       double total = grade1 * grade2 / grade3;

       if (total >= 90) {
           System.out.println("Letter Grade: A");
       } else if (total >= 80) {
           System.out.println("Letter Grade: B");
       } else if (total >= 70) {
           System.out.println("Letter Grade: C");
       } else if (total >= 60) {
           System.out.println("Letter Grade: D");
       } else {
           System.out.println("letter Grade: F");


           return;

       }
   }
   public void isPassing() {
       double grade = grade1 * grade2 / grade3;

   if (grade >= 75) {
       System.out.println("STATUS: PASS");
   }else{
       System.out.println("STATUS: FAILED");
       return;
   }

